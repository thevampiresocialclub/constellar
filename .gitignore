# --- python ---
__pycache__/
*.pyc
.venv/
venv/

# --- secrets (defense in depth; the real config lives at ~/.constellar/config.env) ---
.env
.env.*
!.env.example
config.env
config.env.local
secrets.json
**/secrets/

