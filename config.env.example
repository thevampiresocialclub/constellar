# Constellar — secrets template.
#
# To use: copy this file to ~/.constellar/config.env (i.e. C:\Users\<you>\.constellar\config.env on Windows),
# then fill in your real values. The app reads it on startup.
#
# Lines starting with # are ignored.
# Quotes around values are optional and will be stripped.
# Existing shell environment variables take precedence over this file.

# --- Anthropic (required for AI curation, cluster names, daily distillation) ---
# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# --- Reddit (optional — without these, app falls back to public .rss endpoints
# which are limited to ~25 items/sub and have no vote counts).
# Create a 'script' app at https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# Optional: only needed if you want your *personalized* frontpage instead of r/popular.
# Note: Reddit username/password disable 2FA on this app's auth — use an app password
# if you have 2FA, or skip this section entirely.
REDDIT_USERNAME=
REDDIT_PASSWORD=
